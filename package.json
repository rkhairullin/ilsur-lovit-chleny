{
  "name": "ilsur-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "check": "npm run build && npm test && npm run test:e2e",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
